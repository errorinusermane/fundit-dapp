//backend/tsconfig.json
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",       // 👉 backend 안에 dist 생성
    "rootDir": "./",          // 👉 backend 내부만 빌드 대상으로
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@utils/*": ["./utils/*"]
    },
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["./**/*.ts", "./types/global.d.ts"],
  "exclude": ["./dist"]
}
